@startuml
left to right direction
skinparam dpi 200
skinparam monochrome true
skinparam defaultFontName Helvetica
skinparam packageStyle rectangle
actor "Estudiante\nVoluntario" as E
actor "Coordinador\nONG" as C
actor "Administrador\nuniversitario" as A
actor "Microsoft\nEntra ID" as IDP <<Sistema>>
actor "Servicio de\ncorreo" as M <<Sistema>>
rectangle "Plataforma Voluntariado Connect" {
  usecase "Iniciar sesión" as UC0
  usecase "Gestionar cuenta\ny perfil (E1)" as UC1
  usecase "Registrar y validar\nfundación (E2)" as UC2
  usecase "Gestionar actividades\n(E3)" as UC3
  usecase "Buscar actividades\n(E3)" as UC4
  usecase "Inscribirse en\nactividad (E4)" as UC5
  usecase "Registrar y aprobar\nhoras (E5)" as UC6
  usecase "Descargar certificado\n(E6)" as UC7
  usecase "Verificar certificado\n(E6)" as UC8
  usecase "Generar reportes\n(E6)" as UC9
  usecase "Notificar evento" as UCN
  UC1 ..> UC0 : <<include>>
  UC3 ..> UC0 : <<include>>
  UC5 ..> UC0 : <<include>>
  UC6 ..> UC0 : <<include>>
  UC5 ..> UCN : <<include>>
  UC3 <.. UCN : <<extend>>
}
E --> UC1
E --> UC4
E --> UC5
E --> UC7
C --> UC2
C --> UC3
C --> UC6
C --> UC9
A --> UC2
A --> UC8
A --> UC9
UC0 --> IDP
UCN --> M
@enduml
